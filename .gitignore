# ==============================================================================
# Still Yet Another Sokoban - .gitignore
# ==============================================================================

# Executáveis e binários compilados
syasokoban
*.bin
*.exe

# Arquivos objeto e bibliotecas intermediárias
*.o
*.a
*.so
*.dylib

# Dumps do sistema e arquivos temporários do editor
*~
core
*.swp
*.swo

# Arquivos de backup
*.bak

# Arquivos de log gerados pelo jogo
syasokobanlog.txt
Log_Assertions.txt
*.log

# Scripts auxiliares temporários de ajuste de assets
inspect_banner.py
patch_banner.py

# Visual Studio (arquivos locais e temporários)
/VS/.vs/
/VS/Debug/
/VS/Release/
/VS/*.user
/VS/*.suo
/VS/*.pdb

# Arquivos de sistema do macOS
*.DS_Store
